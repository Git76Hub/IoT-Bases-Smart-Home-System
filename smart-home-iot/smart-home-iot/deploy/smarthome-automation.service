[Unit]
Description=Smart home automation rules and logger
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/.env
ExecStart=__DIR__/.venv/bin/python -m smarthome.automation
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
