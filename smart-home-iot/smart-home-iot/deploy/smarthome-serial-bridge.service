[Unit]
Description=Smart home Arduino serial-to-MQTT bridge
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/.env
ExecStart=__DIR__/.venv/bin/python -m smarthome.serial_bridge
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
